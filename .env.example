# Resend, signups trigger the "new-contact" automation.
NUXT_RESEND_API_KEY=

# Admin notification on new signups. Leave empty to disable.
NUXT_ADMIN_NOTIFY_EMAIL=
# Optional, defaults to "Knecht <news@knecht.works>".
NUXT_ADMIN_NOTIFY_FROM=
# Optional: published Resend template with the variables email, segment,
# country, time. Empty sends a plain inline mail instead.
NUXT_ADMIN_NOTIFY_TEMPLATE_ID=
